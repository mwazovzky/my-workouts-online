# Local development: the SPA is served by the Vite dev server (HMR over
# websockets) and the API by php-fpm, both behind one origin.
access_log off;

# Re-resolve the API host through Docker's DNS instead of pinning the IP it had
# when nginx started, so recreating the api container never leaves a stale
# upstream (502) behind.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream php_api {
    zone php_api 64k;
    server ${PHP_FPM_UPSTREAM} resolve;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 20M;

    include /etc/nginx/api-locations.conf;
    include /etc/nginx/well-known-locations.conf;

    location / {
        proxy_pass http://${SPA_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
