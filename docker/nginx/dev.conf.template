# Local development: the SPA is served by the Vite dev server (HMR over
# websockets) and the API by php-fpm, both behind one origin.
access_log off;

upstream php_api {
    server ${PHP_FPM_UPSTREAM};
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 20M;

    include /etc/nginx/api-locations.conf;
    include /etc/nginx/well-known-locations.conf;

    location / {
        proxy_pass http://${SPA_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
