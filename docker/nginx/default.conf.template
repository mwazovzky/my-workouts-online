access_log off;

# Re-resolve the API host through Docker's DNS instead of pinning the IP it had
# when nginx started, so recreating the api container never leaves a stale
# upstream (502) behind.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream php_api {
    zone php_api 64k;
    server ${PHP_FPM_UPSTREAM} resolve;
}

server {
    listen 80;
    server_name ${DOMAIN_NAME};
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 20M;

    include /etc/nginx/security-headers.conf;
    include /etc/nginx/api-locations.conf;
    include /etc/nginx/well-known-locations.conf;
    include /etc/nginx/spa-locations.conf;
}
