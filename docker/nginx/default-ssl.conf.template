access_log off;

# Re-resolve the API host through Docker's DNS instead of pinning the IP it had
# when nginx started, so recreating the api container never leaves a stale
# upstream (502) behind.
resolver 127.0.0.11 valid=5s ipv6=off;

include /etc/nginx/robots-map.conf;

upstream php_api {
    zone php_api 64k;
    server ${PHP_FPM_UPSTREAM} resolve;
}

server {
    listen 80;
    server_name ${DOMAIN_NAME};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN_NAME};
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 20M;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    include /etc/nginx/security-headers.conf;
    add_header X-Robots-Tag $robots_tag always;
    include /etc/nginx/api-locations.conf;
    include /etc/nginx/well-known-locations.conf;
    include /etc/nginx/spa-locations.conf;
}
