APP_NAME="My Workouts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logs go to the container's stderr (php-fpm forwards them), where Alloy ships
# them to Grafana Cloud Loki in production and `docker compose logs app` shows
# them locally. Use LOG_CHANNEL=stack + LOG_STACK=single to write a file
# instead (storage/logs/laravel.log), which Alloy cannot see.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: one JSON object per line for Loki
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=workouts
DB_USERNAME=workouts
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Mail: `log` writes messages to the application log locally (verification and
# reset links can be copied from `docker compose logs app`). Production uses
# Resend.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=resend
# RESEND_KEY=
# RESEND_WEBHOOK_SECRET=
# INBOUND_EMAIL_FORWARD_TO=

CACHE_STORE=database
# CACHE_PREFIX=

IMAGE_NAME=my-workouts-online_app
IMAGE_TAG=dev
# Written by scripts/deploy-production.sh on every release
APP_VERSION=dev
# Production only: the host nginx serves and the Let's Encrypt certificate name
# DOMAIN_NAME=your-domain.com
# iOS Universal Links: Apple Team ID + bundle id, e.g. ABCDE12345.com.example.app (empty until the app ships)
# APPLE_APP_ID=
APP_PORT=8080
PHP_FPM_UPSTREAM=app:9000

# Observability (Grafana Cloud)
# LOKI_URL must be the full Loki push endpoint, e.g. https://logs-prod-XXX.grafana.net/loki/api/v1/push
LOKI_URL=
LOKI_USER_ID=
LOKI_API_TOKEN=

# Access-token signing (generate with `php artisan jwt:keys`)
JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE=my-workouts
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_COOKIE_SECURE=true

# Requests per minute per user/IP on /api (raise for contract-test runs)
API_RATE_LIMIT_PER_MINUTE=60
