APP_NAME="My Workouts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=workouts
DB_USERNAME=workouts
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

IMAGE_NAME=my-workouts-online_app
IMAGE_TAG=dev
APP_PORT=8080
PHP_FPM_UPSTREAM=app:9000

# Observability (Grafana Cloud)
# LOKI_URL must be the full Loki push endpoint, e.g. https://logs-prod-XXX.grafana.net/loki/api/v1/push
LOKI_URL=
LOKI_USER_ID=
LOKI_API_TOKEN=

# Access-token signing (generate with `php artisan jwt:keys`)
JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE=my-workouts
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_COOKIE_SECURE=true

# Requests per minute per user/IP on /api (raise for contract-test runs)
API_RATE_LIMIT_PER_MINUTE=60
